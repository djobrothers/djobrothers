# Vercel / Client Environment Variables Example
# Set this variable in Vercel Project Settings -> Environment Variables

# Production API Endpoint hosted on Render (e.g. https://djo-backend-api.onrender.com/api)
# In local development, leave empty or unset to automatically use the Vite proxy (/api)
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
