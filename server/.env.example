# Render / Server Environment Variables Example
NODE_ENV=production
PORT=10000

# Neon PostgreSQL Database Connection (Obtained from Neon Dashboard)
# Example: postgresql://neondb_owner:npg_xyz123@ep-cool-snow-a5abc123.eastus2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL Fallback (Unused when DATABASE_URL is set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=djo_corporate_db
DB_USER=postgres
DB_PASSWORD=postgres

# CORS Allowed Origins (Comma-separated list of Vercel frontend domains)
# Example: https://djo-corporate.vercel.app,http://localhost:3000
CORS_ORIGIN=https://your-frontend-app.vercel.app

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="DJO Enquiries <enquiries@djo-engineering.com>"
ADMIN_EMAIL="sales@djo-engineering.com"
